// Example 2: Control Flow
// Demonstrates if/else, while loops, and comparison operators.

x = 10

// If/else
if x > 5:
    print "x is greater than 5"
else:
    print "x is not greater than 5"
end

// If without else
if x == 10:
    print "x equals 10"
end

// While loop counting down
count = 5
while count > 0:
    print count
    count = count - 1
end
print "blast off!"

// While loop with arithmetic
sum = 0
i = 1
while i <= 10:
    sum = sum + i
    i = i + 1
end
print sum

// Nested if/else
a = 3
b = 7
if a < b:
    if a == 3:
        print "a is 3 and less than b"
    end
else:
    print "a is not less than b"
end

// Comparisons
print 5 == 5
print 5 != 3
print 10 < 20
print 10 > 20
print 5 <= 5
print 7 >= 6
