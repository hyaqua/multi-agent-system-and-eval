// Example 2: Conditionals, comparisons, and while loops
// Demonstrates: if/else, comparisons, while loops

x = 15
y = 10

// Comparisons
print x == y
print x != y
print x < y
print x > y
print x <= y
print x >= y

// If/else
if x > y {
    print "x is greater than y"
} else {
    print "x is not greater than y"
}

// Nested if
score = 85
if score >= 90 {
    print "Grade: A"
} else {
    if score >= 80 {
        print "Grade: B"
    } else {
        if score >= 70 {
            print "Grade: C"
        } else {
            print "Grade: F"
        }
    }
}

// While loop - countdown
count = 5
while count > 0 {
    print count
    count = count - 1
}
print "Liftoff!"

// While loop - sum
sum = 0
i = 1
while i <= 10 {
    sum = sum + i
    i = i + 1
}
print sum
